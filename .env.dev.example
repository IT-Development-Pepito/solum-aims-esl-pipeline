# Copy this file to .env for a developer workstation. Never commit .env.
# The current Settings model consumes ESL_* environment variables. Until a
# development launcher loads .env, import these variables through your shell.

# ESL Application Settings
ESL_ENVIRONMENT=development
# Where the state store is and as whom to connect. No password: it is read
# from the secret bundle under the key state.password (AD-017, #78). The
# startup gate refuses a URL that still embeds one.
ESL_DATABASE_URL=postgresql+psycopg://esl_pipeline_dev@localhost:5432/esl_pipeline_dev
ESL_INTERNAL_HOST=127.0.0.1
ESL_SHADOW_MODE=true

# Who may perform manual operations (FR-023, AD-018): identity=role[,role],
# entries separated by ";". Roles are operator (trigger, status, retry, replay,
# reconcile) and admin (everything, plus schedule enable/disable and fallback).
# The identity is the bare Windows account name as the %USERNAME% variable
# reports it (no domain prefix), compared without regard to case. One entry
# per account; give one account several roles with a comma.
# Empty means nobody is authorized. Not a secret; it is part of the
# configuration snapshot every execution records.
ESL_OPERATOR_ROLES=YOURDOMAIN\your_account=admin

# Used by the PostgreSQL integration tests only; it is not an application
# runtime setting and is not loaded by Settings, so it may carry the test
# database's password. It must never point at a shared or production database.
ESL_TEST_DATABASE_URL=postgresql+psycopg://esl_pipeline_test:URL_ENCODED_PASSWORD@localhost:5432/esl_pipeline_test

# Used by the AIMS compatibility-reader integration tests only (#24). They point
# at the local clone from docs/development/aims-local-clone.md as the SELECT-only
# esl_aims_reader role, must name localhost, and skip when absent, as in CI.
ESL_TEST_AIMS_PORTAL_URL=postgresql+psycopg://esl_aims_reader:URL_ENCODED_PASSWORD@localhost:5432/AIMS_PORTAL_DB
ESL_TEST_AIMS_CORE_URL=postgresql+psycopg://esl_aims_reader:URL_ENCODED_PASSWORD@localhost:5432/AIMS_CORE_DB

# --- SQL Server sources (shared client settings) ---
# Every source is SQL Server: PEPITO_HO is the central iRetail database and each
# store runs a local iRetail instance. One read-only account covers all of them.
# Values are plain, not URL-encoded; the application assembles the connection.
ESL_SOURCE_SQL_USERNAME=your_username
ESL_SOURCE_SQL_DRIVER=ODBC Driver 18 for SQL Server
ESL_SOURCE_SQL_TRUST_SERVER_CERTIFICATE=true

# The instance running RefreshESL_New. It serves both databases below, because
# DBWH_8555 is reached by three-part name from ESL rather than through a link.
ESL_SOURCE_SQL_HOST=host_name
ESL_LEGACY_BASELINE_DATABASE=ESL
ESL_SOURCE_WAREHOUSE_DATABASE=DBWH_8555

# PEPITO_HO - central iRetail database; ITEM_UOM_MAPPING_MST. Remote, so it
# carries its own host.
ESL_SOURCE_PEPITO_HO_HOST=host_name
ESL_SOURCE_PEPITO_HO_DATABASE=PEPITO_HO

# Per-store servers need no variables at all: host and database are read from
# DBWH_8555.dbo.DimStore (ORG_IP, ORG_DB) at run time, validated as a bare IP
# or hostname, and reuse the shared credential above. ORG_IP holds no port.

# --- AIMS PostgreSQL (read-only, AD-003) ---
# AIMS_OTA_DB is deliberately absent: it holds firmware and OTA data only, and
# nothing in the label or article path reads it. For development, point these
# at the local clone described in docs/development/aims-local-clone.md.
ESL_AIMS_HOST=host_name
ESL_AIMS_PORT=5432
ESL_AIMS_PORTAL_DATABASE=AIMS_PORTAL_DB
ESL_AIMS_PORTAL_USERNAME=username
ESL_AIMS_CORE_DATABASE=AIMS_CORE_DB
ESL_AIMS_CORE_USERNAME=username

# --- Secrets ---
# No password appears here, in any environment. Every password is read from the
# DPAPI bundle by a fixed key (#78) and provisioned with `esl-admin secrets set`
# (#79). Bundle keys:
#   state.password         the state store above
#   source.sql.password    every SQL Server tier, including per-store servers
#   aims.portal.password
#   aims.core.password
# Prove each one with `esl-admin check-connections`.
ESL_SECRET_BUNDLE_PATH=C:\ProgramData\SOLUM\ESL\secrets.dpapi
