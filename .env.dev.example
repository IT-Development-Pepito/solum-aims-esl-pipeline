# Copy this file to .env for a developer workstation. Never commit .env.
# The current Settings model consumes ESL_* environment variables. Until a
# development launcher loads .env, import these variables through your shell.

# ESL Application Settings
ESL_ENVIRONMENT=development
ESL_DATABASE_URL=postgresql+psycopg://esl_pipeline_dev:URL_ENCODED_PASSWORD@localhost:5432/esl_pipeline_dev
ESL_INTERNAL_HOST=127.0.0.1
ESL_SHADOW_MODE=true

# Used by Task 3 integration tests only; it is not an application runtime setting.
ESL_TEST_DATABASE_URL=postgresql+psycopg://esl_pipeline_test:URL_ENCODED_PASSWORD@localhost:5432/esl_pipeline_test

# The two URLs above still embed their password because they are live Settings
# fields. Issue #78 moves that password to the secret bundle and splits the
# remaining parts, matching the source settings below.

# --- SQL Server sources (shared client settings) ---
# Every source is SQL Server: PEPITO_HO is the central iRetail database and each
# store runs a local iRetail instance. One read-only account covers all of them.
# Values are plain, not URL-encoded; the application assembles the connection.
ESL_SOURCE_SQL_USERNAME=your_username
ESL_SOURCE_SQL_DRIVER=ODBC Driver 18 for SQL Server
ESL_SOURCE_SQL_TRUST_SERVER_CERTIFICATE=true

# The instance running RefreshESL_New. It serves both databases below, because
# DBWH_8555 is reached by three-part name from ESL rather than through a link.
ESL_SOURCE_SQL_HOST=host_name
ESL_LEGACY_BASELINE_DATABASE=ESL
ESL_SOURCE_WAREHOUSE_DATABASE=DBWH_8555

# PEPITO_HO - central iRetail database; ITEM_UOM_MAPPING_MST. Remote, so it
# carries its own host.
ESL_SOURCE_PEPITO_HO_HOST=host_name
ESL_SOURCE_PEPITO_HO_DATABASE=PEPITO_HO

# Per-store servers need no variables at all: host and database are read from
# DBWH_8555.dbo.DimStore (ORG_IP, ORG_DB) at run time and reuse the shared
# credential above. ORG_IP holds a bare IP address with no port.

# --- AIMS PostgreSQL (read-only, AD-003) ---
# AIMS_OTA_DB is deliberately absent: it holds firmware and OTA data only, and
# nothing in the label or article path reads it.
ESL_AIMS_HOST=host_name
ESL_AIMS_PORT=5432
ESL_AIMS_PORTAL_DATABASE=AIMS_PORTAL_DB
ESL_AIMS_PORTAL_USERNAME=username
ESL_AIMS_CORE_DATABASE=AIMS_CORE_DB
ESL_AIMS_CORE_USERNAME=username

# --- Secrets ---
# No source or AIMS password appears here, in any environment. Every password is
# read from the DPAPI bundle by name (#78), which the admin CLI provisions (#79).
# Expected bundle keys:
#   source.sql.password
#   aims.portal.password
#   aims.core.password
ESL_SECRET_BUNDLE_PATH=C:\ProgramData\SOLUM\ESL\secrets.dpapi
