# Reference only. Do not deploy a plaintext .env.production file and never
# commit live values. Provision these environment variables only to the
# dedicated Windows Service account through the approved deployment process.
#
# No variable here carries a password, in any environment (AD-017, #78).
# Every password lives in the DPAPI bundle at ESL_SECRET_BUNDLE_PATH, written
# by the service account with `esl-admin secrets set` (#79). The startup gate
# refuses an ESL_DATABASE_URL that still embeds one.

ESL_ENVIRONMENT=production
ESL_DATABASE_URL=postgresql+psycopg://esl_pipeline_service@POSTGRES_HOST:5432/esl_pipeline
ESL_INTERNAL_HOST=INTERNAL_HOSTNAME_OR_IP
# The operations API (#28) listens on ESL_INTERNAL_HOST:ESL_INTERNAL_PORT only;
# callers authenticate with api.token.<account> keys from the bundle (AD-019).
ESL_INTERNAL_PORT=8000
# Recent executions included per workflow/store by the authenticated /metrics endpoint (#109).
ESL_METRICS_RUN_LIMIT=20
ESL_SHADOW_MODE=true

# This path is enforced by the production Settings validation, and the bundle's
# owner and ACL are validated at startup.
ESL_SECRET_BUNDLE_PATH=C:\ProgramData\SOLUM\ESL\secrets.dpapi

# Use the exact SID and registered service name on the production host.
# The application validates that they resolve to the configured Windows Service.
# `esl-admin secrets set` refuses to write unless it runs as this SID, because
# under user-scope DPAPI a bundle written by any other account is unreadable.
ESL_SERVICE_IDENTITY_SID=S-1-5-21-REPLACE_WITH_SERVICE_ACCOUNT_SID
ESL_WINDOWS_SERVICE_NAME=SOLUM_ESL_PIPELINE

# Who may perform manual operations (FR-023, AD-018): identity=role[,role],
# entries separated by ";". operator = trigger, status, retry, replay,
# reconcile; admin = all of those plus schedule enable/disable and fallback.
# Identities are Windows account names, compared without regard to case. A
# malformed value stops the service at startup; an empty one authorizes nobody.
ESL_OPERATOR_ROLES=DOMAIN\esl_operator=operator;DOMAIN\esl_admin=admin

# --- SQL Server sources (non-secret parts only) ---
# One read-only account and one ODBC driver cover every SQL Server tier.
ESL_SOURCE_SQL_HOST=SQL_HOST_RUNNING_REFRESHESL
ESL_SOURCE_SQL_USERNAME=esl_reader
ESL_SOURCE_SQL_DRIVER=ODBC Driver 18 for SQL Server
# READ COMMITTED or SNAPSHOT (AD-020). Switch to SNAPSHOT only after a DBA has
# enabled ALLOW_SNAPSHOT_ISOLATION on every source database.
ESL_SOURCE_SQL_ISOLATION_LEVEL=READ COMMITTED
# Per-store fan-out bounds (#92): at most this many store servers are read at
# once, and each statement is bounded. Provisional until baselined (NFR-004).
ESL_SOURCE_STORE_CONCURRENCY=4
ESL_SOURCE_STORE_READ_TIMEOUT_SECONDS=120
# Executions the worker (#102) runs at once (1-8). Provisional (NFR-004).
ESL_WORKER_CONCURRENCY=1
ESL_SOURCE_SQL_TRUST_SERVER_CERTIFICATE=true
ESL_LEGACY_BASELINE_DATABASE=ESL
ESL_SOURCE_WAREHOUSE_DATABASE=DBWH_8555
ESL_SOURCE_PEPITO_HO_HOST=PEPITO_HO_HOST
ESL_SOURCE_PEPITO_HO_DATABASE=PEPITO_HO
# Per-store servers are addressed from DBWH_8555.dbo.DimStore at run time.

# --- AIMS PostgreSQL (read-only, AD-003; non-secret parts only) ---
ESL_AIMS_HOST=AIMS_POSTGRES_HOST
ESL_AIMS_PORT=5432
# Seconds the AIMS reader waits for a connection before the fault is retryable (#112).
ESL_AIMS_CONNECT_TIMEOUT_SECONDS=10
# AIMS Dashboard service that owns the page-change operation (#23, AD-021).
# A different host and port from the AIMS databases; leave blank until ACTIVE is enabled.
ESL_AIMS_DASHBOARD_BASE_URL=
ESL_AIMS_DASHBOARD_TIMEOUT_SECONDS=30
ESL_AIMS_PORTAL_DATABASE=AIMS_PORTAL_DB
ESL_AIMS_PORTAL_USERNAME=esl_aims_reader
ESL_AIMS_CORE_DATABASE=AIMS_CORE_DB
ESL_AIMS_CORE_USERNAME=esl_aims_reader

# Bundle keys the service reads, provisioned as the service account:
#   state.password  source.sql.password  aims.portal.password  aims.core.password
# Startup names any missing key by name only. Verify with
# `esl-admin check-connections` before starting the service.
