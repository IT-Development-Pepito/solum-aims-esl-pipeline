# Reference only. Do not deploy a plaintext .env.production file and never
# commit live values. Provision these environment variables only to the
# dedicated Windows Service account through the approved deployment process.

ESL_ENVIRONMENT=production
ESL_DATABASE_URL=postgresql+psycopg://esl_pipeline_service:URL_ENCODED_PASSWORD@POSTGRES_HOST:5432/esl_pipeline
ESL_INTERNAL_HOST=INTERNAL_HOSTNAME_OR_IP
ESL_SHADOW_MODE=true

# This path is enforced by the production Settings validation.
ESL_SECRET_BUNDLE_PATH=C:\ProgramData\SOLUM\ESL\secrets.dpapi

# Use the exact SID and registered service name on the production host.
# The application validates that they resolve to the configured Windows Service.
ESL_SERVICE_IDENTITY_SID=S-1-5-21-REPLACE_WITH_SERVICE_ACCOUNT_SID
ESL_WINDOWS_SERVICE_NAME=SOLUM_ESL_PIPELINE
