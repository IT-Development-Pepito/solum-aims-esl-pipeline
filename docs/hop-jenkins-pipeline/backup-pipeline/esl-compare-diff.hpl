  <transform>
    <name>Table input DB SKU Internal NEW</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DB ESL Product</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT * FROM
(
SELECT [STORE_CODE]
      ,[ITEM_CODE]
      ,[BARCODE]
      ,REPLACE(CAST([ITEM_NAME] AS CHAR), ',', '.') AS [ITEM_NAME]
      ,REPLACE(CAST([ITEM_SHORTNAME] AS CHAR), ',', '.') AS [ITEM_SHORTNAME]
      ,[SALES_PRICE]
      ,[DISC_PRICE]
      ,[DISC_PERCENT]
      ,
		REPLACE(
      	CAST(
		  CASE 
        	WHEN [DISC_TEXT] IS NULL OR [DISC_TEXT] = '' THEN ''
        	WHEN [DISC_TEXT] LIKE '%|%|%|%|%' THEN [DISC_TEXT]
			WHEN [CAMPAIGN_GROUP] LIKE '%PFS%' THEN 'PFS'
       		-- 3. Extract 4th item ONLY when text has EXACTLY 3 pipes
        	WHEN [DISC_TEXT] LIKE '%|%|%|%' AND (PROMOTION_TYPE = 'PERCENT BASED' OR PROMOTION_TYPE = 'VALUE BASED') AND ([DISC_TEXT] like '%IN STORE PROMO%' OR [DISC_TEXT] like '%SUPER SAVER%') THEN (
        	SELECT LTRIM(RTRIM(value))
        	FROM OPENJSON('["' + REPLACE(STRING_ESCAPE([DISC_TEXT], 'json'), '|', '","') + '"]')
        	WHERE [key] = 3
			)
            ELSE [DISC_TEXT]
	  		END 
		AS VARCHAR(100)), ',', '.') AS [DISC_TEXT]
      ,[MEMBER_PRICE]
      ,[SOH]
      ,[EARLY_EXPIRY_DATE]
      ,[PROD_WEIGHT]
      ,[MIN_QTY]
      ,[MAX_QTY]
      ,[PRODUCT_URL]
      ,[DIVISION]
      ,[DEPARTMENT]
      ,[CLASS]
      ,[SUBCLASS]
      ,[BRAND]
      ,[CLASS_ROTATION]
      ,[NFC_URL]
      ,[CONSIGMENT]
      ,[RETURNABLE]
      ,[EXPIRY_DAYS]
      ,[DISPLAY_QTY]
      ,[LAST_UPDATED_DATE]
      ,[SYNC_REC]
      ,[UOM]
      ,[PROMO_FLAG]
      ,[PER_GRM_PROMO_PRICE]
      ,[PER_GRM_SELL_PRICE]
      ,[PROMOTION_TYPE]
      ,[CAMPAIGN_GROUP]
      ,[REDLIST]
      ,[SAVE_AMT]
      ,[CREATED_DATE]
      ,CASE 
        WHEN [PROMO_START_DATE] = '' THEN ''
        ELSE LEFT(CONVERT(VARCHAR(11), CAST([PROMO_START_DATE] AS DATE), 106), 6)
        END AS [PROMO_START_DATE]
      ,CASE 
        WHEN [PROMO_END_DATE] = '' THEN ''
        ELSE LEFT(CONVERT(VARCHAR(11), CAST([PROMO_END_DATE] AS DATE), 106), 6)
        END AS [PROMO_END_DATE]
      ,[PROMO_START_TIME]
      ,[PROMO_END_TIME]
  FROM [ESL].[dbo].[tb_ESL] 
WHERE STORE_CODE = '${STORE_CODE_PARAM}'
 -- AND LAST_UPDATED_DATE >= DATEADD(day, -2, GETDATE());
) AS SUBQ
/*WHERE 
DISC_TEXT NOT LIKE '%CLEARANCE%' AND
DISC_TEXT NOT LIKE '%END OF DAY%' AND
DISC_TEXT NOT LIKE '%IN STORE PROMO%' AND
DISC_TEXT NOT LIKE '%SUPER FRESH%' AND
DISC_TEXT NOT LIKE '%SUPER SAVER%' AND
DISC_TEXT NOT LIKE '%PRICE DROP%' AND
DISC_TEXT NOT LIKE '%PFS%' AND
DISC_TEXT NOT LIKE '%MODIS%' 
*/


ORDER BY ITEM_CODE ASC</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
