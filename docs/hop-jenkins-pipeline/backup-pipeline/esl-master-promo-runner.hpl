    <sql>SELECT DISTINCT store_code FROM esl.dbo.tb_esl 
WHERE store_code = '084'
</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>112</yloc>
