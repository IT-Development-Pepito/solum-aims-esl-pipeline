  <transform>
    <name>Table input current page ESL</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DB AIMS PORTAL (ESL ID - Product ID)</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT station_code, label_code, pages FROM enddevice a
JOIN
end_device_articles b ON a.code = b.label_code 
WHERE station_code = '${STORE_CODE_PARAM}' AND
--(
a.state = 'SUCCESS' 
--OR a.state = 'TIMEOUT')
ORDER BY label_code ASC

</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>304</yloc>
    </GUI>
  </transform>
