    <action>
      <name>Check DB Connection</name>
      <description/>
      <type>CHECK_DB_CONNECTIONS</type>
      <attributes/>
      <connections>
        <connection>
          <name>DB AIMS PORTAL (ESL ID - Product ID)</name>
